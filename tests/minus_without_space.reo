fn sub(a: i64) -> i64 {
    return a-1;
}

fn main() {
    let a: i64 = 3;
    let n: i64 = a-1;
    assert(n == 2i64);
    assert(a -1 == 2i64);
    assert(a- 1 == 2i64);
    assert(1-2 == -1i64);
    assert(sub(4i64) == 3i64);
    let negative: i64 = -7i64;
    assert(negative == -7i64);
    assert(0i64-1i64 == -1i64);
}
