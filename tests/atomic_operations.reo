fn main() {
    let value: u32 = 0u32;
    let pointer: *mut u32 = (&mut value) as *mut u32;
    assert(atomic_fetch_add(pointer, 3u32, "relaxed") == 0u32);
    let expected: u32 = 0u32;
    let pe: *mut u32 = (&mut expected) as *mut u32;
    assert(!atomic_compare_exchange(pointer, pe, 7u32, "acq_rel", "acquire"));
    assert(expected == 3u32);
    assert(atomic_compare_exchange(pointer, pe, 7u32, "acq_rel", "acquire"));
    assert(atomic_load(pointer, "acquire") == 7u32);
}
